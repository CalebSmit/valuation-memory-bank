# Valuation Memory Bank — Environment Variables
# Copy this file to .env and fill in values as needed.
# The MVP runs with all defaults — no required configuration.

# ─── Database ───────────────────────────────────────────────────────────────
# For local development, the app uses SQLite at ./local.db (default).
# For Cloudflare Pages + D1, set the D1 binding name in wrangler.toml.
DATABASE_URL=./local.db

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Auth ───────────────────────────────────────────────────────────────────
# MVP uses mock auth (demo@valuation-memory-bank.local).
# To enable real auth, set AUTH_ENABLED=true and configure your provider.
AUTH_ENABLED=false
# AUTH_SECRET=your-secret-here
# AUTH_PROVIDER=clerk|nextauth|custom

# ─── AI Integration (optional) ──────────────────────────────────────────────
# MVP includes AI placeholders only. Set AI_ENABLED=true to activate live AI.
AI_ENABLED=false
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=gpt-4o

# ─── Cloudflare (for deployment) ─────────────────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
